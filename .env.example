# Supabase Credentials (Get from Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Connection Strings (Optional for direct CLI migrations)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.your-project.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.your-project.supabase.co:5432/postgres"

# Tredict API Credentials (Get from Tredict > Settings > Personal API / MCP)
TREDICT_API_TOKEN=your-tredict-access-token

